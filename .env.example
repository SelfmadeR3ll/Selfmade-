# Genius AI Environment Configuration
# =====================================
# Copy this to .env and fill in your values

# AI Brain (OpenAI API key or compatible)
GENIUS_LLM_API_KEY=your-api-key-here
GENIUS_LLM_MODEL=gpt-4
GENIUS_LLM_BASE_URL=https://api.openai.com/v1

# Voice Settings
GENIUS_VOICE_ENABLED=true
GENIUS_VOICE_LANGUAGE=en

# Server
GENIUS_HOST=0.0.0.0
GENIUS_PORT=8000
GENIUS_DEBUG=false

# Google Calendar (place credentials.json in project root)
GENIUS_GOOGLE_CREDENTIALS_FILE=credentials.json
GENIUS_GOOGLE_TOKEN_FILE=token.json
