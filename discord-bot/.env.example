# ─── Bot Credentials ────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# ─── Guild / Server ──────────────────────────────────────────────────────────
# Your Discord server ID (right-click server → Copy Server ID)
GUILD_ID=your_guild_id_here

# ─── Channels ────────────────────────────────────────────────────────────────
# Fill these in after running: npm run setup
WELCOME_CHANNEL_ID=
GOODBYE_CHANNEL_ID=
LOG_CHANNEL_ID=
MUSIC_CHANNEL_ID=

# ─── Roles ───────────────────────────────────────────────────────────────────
# Fill these in after running: npm run setup
NEW_MEMBER_ROLE_ID=
MEMBER_ROLE_ID=
MUTED_ROLE_ID=
